# The only service that is published. It sends what the backend serves to `sermo` and everything
# else to `web`, and it is the place that decides the client address. Both upstreams receive
# X-Forwarded-For set to {client_ip} alone: the address of the connection when no trusted_proxies
# are configured (any value the client sent is ignored), or the real client address when the
# connection comes from a configured trusted proxy. One value, never a list, whatever is in front.
# If another proxy or load balancer is in front of this one, name it with trusted_proxies (see
# "TLS" in docs/deployment.md).
{
	admin off
	persist_config off
	# TLS is not terminated here by default; see "TLS" in docs/deployment.md.
	auto_https off
}

:8080 {
	# Largest request body, for uploads. Keep it above the upload limit set in the administration
	# panel (the default there is 25 MiB) plus about 1 MiB of form framing.
	request_body {
		max_size {$INGRESS_MAX_BODY:32MiB}
	}

	# Every path the backend serves to a browser or a crawler: Better Auth, the REST API (files
	# included), the MCP endpoint, health, the sitemaps, the feeds, robots.txt, llms.txt and the
	# IndexNow key file (<key>.txt).
	@backend {
		path /api/* /mcp /health /robots.txt /llms.txt /sitemap.xml /sitemaps/* /feed.atom /forums/*/feed.atom /nodes/*/feed.atom /*.txt
	}
	# Cloudflare's visitor location headers are dropped here, because a visitor can send them too.
	# Behind Cloudflare, with SERMO_TRUST_LOCATION_HEADERS=true, delete these three lines from each
	# upstream (see "Sign-in location and log retention" in docs/deployment.md).
	handle @backend {
		reverse_proxy sermo:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up -CF-IPCountry
			header_up -CF-Region
			header_up -CF-IPCity
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up -CF-IPCountry
			header_up -CF-Region
			header_up -CF-IPCity
		}
	}
}

# Answered by the ingress alone, for its own health check; not published.
:8081 {
	respond /ready 200
}
