{
  "name": "sermo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "bun packages/api/src/server.ts",
    "dev:fixture": "bun scripts/dev-fixture.ts",
    "starter:load": "bun scripts/starter/load.ts",
    "staging:build": "bun scripts/staging.ts build",
    "staging:start": "bun scripts/staging.ts start",
    "staging:stop": "bun scripts/staging.ts stop",
    "staging:status": "bun scripts/staging.ts status",
    "lighthouse": "bun scripts/lighthouse.ts",
    "storage:migrate": "bun scripts/storage-migrate.ts",
    "images:widths": "bun scripts/image-widths.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "bun test ./packages ./scripts ./bench ./load",
    "seed": "bun bench/seed.ts",
    "seed:large": "bun bench/seed.ts --profile large",
    "bench": "bun bench/run.ts",
    "dupes": "jscpd apps/web/src packages scripts bench",
    "db:generate": "cd packages/core && drizzle-kit generate",
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:web && bun run bench",
    "check:fast": "bun run typecheck && bun run lint && bun run test && bun run check:web",
    "check:web": "cd apps/web && bun run typecheck && bun run test && bun run build && bun run js-budget"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lhci/cli": "0.15.1",
    "@sermo/api": "workspace:*",
    "@sermo/core": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/busboy": "1.5.4",
    "@types/node": "26.6.4",
    "jscpd": "4.0.5",
    "puppeteer-core": "25.14.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "busboy": "1.6.0"
  },
  "overrides": {
    "lighthouse": "13.5.0"
  }
}
