{
  "name": "sermo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "bun packages/api/src/server.ts",
    "dev:fixture": "bun scripts/dev-fixture.ts",
    "starter:load": "bun scripts/starter/load.ts",
    "storage:migrate": "bun scripts/storage-migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "bun test ./packages ./scripts",
    "seed": "bun bench/seed.ts",
    "bench": "bun bench/run.ts",
    "db:generate": "cd packages/core && drizzle-kit generate",
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:web && bun run bench",
    "check:fast": "bun run typecheck && bun run lint && bun run test && bun run check:web",
    "check:web": "cd apps/web && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sermo/api": "workspace:*",
    "@sermo/core": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/busboy": "1.5.4",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "busboy": "1.6.0"
  }
}
