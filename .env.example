# Copy to .env. Compose reads it for every service. Lines marked SECRET must stay out of version
# control and backups that others can read. The defaults serve a first run on http://localhost:8080.
#
# Compose fixes these, so do not set them here: PORT, SERMO_DB_PATH, SERMO_TRUSTED_PROXY_HEADER,
# SERMO_SESSION_COOKIE_CACHE, SERMO_API_URL, SERMO_PUBLIC_URL.

# --- Public address and ingress ---
# Public origin of the whole site, as the browser sees it. It is the backend's base URL, its
# trusted origin and the web app's public URL, so it must match the address in the browser bar.
# Use HTTPS in production.
BETTER_AUTH_URL=http://localhost:8080
# Port the ingress publishes on the host. Change BETTER_AUTH_URL with it.
INGRESS_PORT=8080
# Largest request body the ingress accepts. Raise it with the upload limit in the administration
# panel (default 25 MiB); the limit there is the one members meet.
INGRESS_MAX_BODY=32MiB
# Public origin used for canonical links, sitemaps and feeds; defaults to BETTER_AUTH_URL.
SERMO_SITE_URL=
# Extra comma-separated origins permitted for cookie-authenticated requests.
SERMO_TRUSTED_ORIGINS=

# --- Secrets and first administrator ---
# SECRET. Required: generate with:
# docker run --rm oven/bun:1.4.2-slim bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex'))"
BETTER_AUTH_SECRET=
# Optional one-time administrator bootstrap; set all three together or leave blank. The account is
# created at startup only while the site has no administrator. Remove the password afterwards.
SERMO_ADMIN_USERNAME=
SERMO_ADMIN_EMAIL=
# SECRET.
SERMO_ADMIN_PASSWORD=

# --- Storage ---
# local keeps uploads on the data volume; s3 uses Amazon S3 or Cloudflare R2.
SERMO_STORAGE_DRIVER=local
# Upload directory for local storage; empty means /data/files on the volume.
SERMO_FILES_DIR=
# Optional public image proxy/CDN origin. It must proxy /api/v1/files/* to the backend.
SERMO_PUBLIC_FILES_URL=
# For SERMO_STORAGE_DRIVER=s3.
SERMO_S3_BUCKET=
SERMO_S3_ENDPOINT=
SERMO_S3_REGION=
SERMO_S3_ACCESS_KEY_ID=
# SECRET.
SERMO_S3_SECRET_ACCESS_KEY=

# --- Email ---
# none sends nothing; capture keeps messages in memory for development; smtp delivers them.
SERMO_MAIL_DRIVER=none
SERMO_MAIL_FROM=
SERMO_MAIL_REPLY_TO=
SERMO_SMTP_HOST=
SERMO_SMTP_PORT=587
SERMO_SMTP_SECURE=false
# STARTTLS is required unless SERMO_SMTP_SECURE=true or the host is loopback. Set false only for
# a plain-text relay on a private network (for example a sidecar container); true forces it.
SERMO_SMTP_REQUIRE_TLS=
SERMO_SMTP_USER=
# SECRET.
SERMO_SMTP_PASSWORD=

# --- Web Push ---
# Optional. Generate one permanent VAPID key pair; set all three values to enable push.
SERMO_VAPID_PUBLIC_KEY=
# SECRET.
SERMO_VAPID_PRIVATE_KEY=
SERMO_VAPID_SUBJECT=

# --- Rate limits ---
# Requests per minute per visitor (defaults 300, 60, 30, 60). A web app that renders pages from
# several reads per visit needs a higher read limit.
SERMO_RATE_LIMIT_READ=
SERMO_RATE_LIMIT_WRITE=
SERMO_RATE_LIMIT_SEARCH=
SERMO_RATE_LIMIT_MCP=

# --- Sign-in location and log retention ---
# Days the address, device and place log is kept before the daily job deletes it (default 180).
SERMO_IP_LOG_RETENTION_DAYS=
# Optional. Path of a MaxMind GeoLite2/GeoIP2 City or Country database (.mmdb) inside the backend
# container, for the approximate place of sign-ins and posts when no proxy reports one (for example
# /data/GeoLite2-City.mmdb on the data volume). Empty: no lookup.
SERMO_GEOIP_DATABASE=
# Set true ONLY when Cloudflare is in front and nothing but Cloudflare can reach the ingress, with
# "Add visitor location headers" turned on (Rules > Managed Transforms). The backend then takes the
# visitor's country, region and city from those headers. Anywhere else a visitor could forge them.
SERMO_TRUST_LOCATION_HEADERS=false
