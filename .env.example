# Required: generate with:
# docker run --rm oven/bun:1.4.2-slim bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex'))"
BETTER_AUTH_SECRET=
# Public URL that clients use to reach Sermo; use HTTPS in production.
BETTER_AUTH_URL=http://localhost:3000
# Public origin used for canonical links, sitemaps and feeds; defaults to BETTER_AUTH_URL.
SERMO_SITE_URL=
# Extra comma-separated origins permitted for cookie-authenticated requests.
SERMO_TRUSTED_ORIGINS=
# Set only when Sermo is behind a trusted proxy; e.g. x-forwarded-for.
SERMO_TRUSTED_PROXY_HEADER=
# Optional one-time administrator bootstrap; set all three together or leave blank.
SERMO_ADMIN_USERNAME=
SERMO_ADMIN_EMAIL=
SERMO_ADMIN_PASSWORD=
# Container port. Keep 3000 with the supplied Compose port mapping and health check.
PORT=3000
